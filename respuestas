// 2- escribe una funcipon que permita validar el cierre correcto de parentesis
function validarExpresion(exp) {
  const arr = [];
  const par = {
    "(": ")",
    "{": "}",
    "[": "]",
  };

  for (let i = 0; i < exp.length; i++) {
    const char = exp[i];
    if (char in par) {
      arr.push(char);
    } else if (char === ")" || char === "}" || char === "]") {
      const llaveFinal = arr.pop();
      if (!llaveFinal || par[llaveFinal] !== char) {
        return false;
      }
    }
  }
  return arr.length === 0;
}
const exp = "()(())()";
console.log(validarExpresion(exp));

// 3- indicar si un string es palindromo
function esPalindromo(str) {
  // Eliminar espacios en blanco y convertir a minúsculas
  const cleanedStr = str.toLowerCase().replace(/\s/g, "");
  // Comparar el string original con su reverso
  return cleanedStr === cleanedStr.split("").reverse().join("");
}

const string1 = "anita lava la tina";
const string2 = "hello world";

console.log(esPalindromo(string1));
console.log(esPalindromo(string2));

// 4- dividir dos números si utilizar el signo de división o multiplicación
function divisionSinOperadores(dividendo, divisor) {
  // Manejar casos especiales
  if (divisor === 0) {
    throw new Error("No se puede dividir por cero");
  }
  if (dividendo === 0) {
    return 0;
  }

  let cociente = 0;
  let signo = 1;

  // Manejar signo
  if ((dividendo < 0 && divisor > 0) || (dividendo > 0 && divisor < 0)) {
    signo = -1;
  }

  // Convertir ambos números a positivos
  dividendo = Math.abs(dividendo);
  divisor = Math.abs(divisor);

  // Sustracción repetida
  while (dividendo >= divisor) {
    dividendo -= divisor;
    cociente++;
  }

  return cociente * signo;
}

console.log(divisionSinOperadores(10, 2));
console.log(divisionSinOperadores(10, 3));
console.log(divisionSinOperadores(-10, 3));

// 5- al iterar un array de números solo una vez, indicar el elemento mayor y menor
function encontrarMayorYMenor(array) {
  if (array.length === 0) {
    return null; // Devolver null si el array está vacío
  }

  let mayor = array[0];
  let menor = array[0];

  for (let i = 1; i < array.length; i++) {
    if (array[i] > mayor) {
      mayor = array[i];
    }
    if (array[i] < menor) {
      menor = array[i];
    }
  }

  return { mayor, menor };
}

const numeros = [4, 2, 7, 1, 9, 5];
const resultado = encontrarMayorYMenor(numeros);
console.log("El número mayor es:", resultado.mayor);
console.log("El número menor es:", resultado.menor);

